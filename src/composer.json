{
    "name": "sandbox/php-ecommerce",
    "description": "Simple PHP ecommerce REST API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "predis/predis": "^2.0",
        "php-amqplib/php-amqplib": "^3.5",
        "doctrine/orm": "^3.6",
        "doctrine/dbal": "^4.4",
        "symfony/cache": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "../tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
